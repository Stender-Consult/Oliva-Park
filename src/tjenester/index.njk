---
layout: base.njk
title: Tjenester
permalink: /tjenester/
---
{% from "service-hero.njk" import serviceHero, cta %}
{{ serviceHero("/images/fjordhoyden-10.jpg", "Gangvei i gatestein med plantebed og plen", "Tjenester", "", "Fire fag, ett lag", "", "", "Fagområder som ofte kombineres i samme prosjekt, for private, borettslag, næring og offentlige oppdragsgivere.") }}
<section class="h-sek">
  <div class="wrap">
    <div class="fag-grid fag-grid-2 reveal-group">
      {% set fag = [
        ["utenomhusarbeider", "01", "Utenomhusarbeider", "Vi opparbeider uteområder som er fine å se på og gode å bruke, fra hager og gårdsplasser til fellesarealer.", "fjordhoyden-12.jpg"],
        ["grunn-va", "02", "Grunn- og VA-arbeider", "Godt grunnarbeid og solide VA-løsninger legger grunnlaget for alt som bygges over.", "gravemaskin-oliva-park.jpg"],
        ["skjotsel", "03", "Skjøtsel og vedlikehold", "Enkeltoppdrag og faste skjøtselsavtaler, så anlegget holder seg fint år etter år.", "skjotsel-plenklipp.jpg"],
        ["riving", "04", "Rivearbeider", "Sikker og ryddig riving, planlagt ut fra konstruksjon, omgivelser og videre bruk.", "riving-oliva-park.jpg"]
      ] %}
      {% for f in fag %}
      <a class="fag reveal" href="/tjenester/{{ f[0] }}/">
        <img src="/images/{{ f[4] }}" alt="" loading="lazy">
        <span class="fag-tekst"><span class="fag-nr">{{ f[1] }}</span><h3>{{ f[2] }}</h3><span class="fag-desc">{{ f[3] }}</span></span>
        <span class="fag-pil" aria-hidden="true">→</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{{ cta() }}
