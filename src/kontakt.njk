---
layout: base.njk
title: Kontakt
permalink: /kontakt/
---
{% from "service-hero.njk" import serviceHero %}
{{ serviceHero("/images/barnehager-oslo-9.jpg", "To fagarbeidere fra Oliva Park raker jord på et uteområde", "Kontakt", "", "Kontakt oss", "", "", "Spørsmål, befaring eller et nytt prosjekt? Send oss en melding, så tar vi kontakt.") }}

<section class="h-sek h-sek-siste kontakt-sek">
  <div class="wrap contact-grid">
    <div class="contact-main kontakt-kort">
      <h2>Send oss en melding</h2>
      <p>Fortell kort hva du trenger hjelp med, så tar vi kontakt så snart vi kan.</p>
      <form class="contact-form" id="contactForm" novalidate>
        <div class="form-to">
          <div class="form-row">
            <label for="cf-name">Navn</label>
            <input type="text" id="cf-name" name="name" autocomplete="name" required aria-describedby="err-name">
            <span class="form-error" id="err-name" hidden>Skriv inn navnet ditt.</span>
          </div>
          <div class="form-row">
            <label for="cf-email">E-post</label>
            <input type="email" id="cf-email" name="email" autocomplete="email" required aria-describedby="err-email">
            <span class="form-error" id="err-email" hidden>Skriv inn en gyldig e-postadresse.</span>
          </div>
        </div>
        <fieldset class="form-row form-valg">
          <legend>Hva gjelder det? <span class="valgfritt">Valgfritt</span></legend>
          <div class="valg-rad">
            <label><input type="checkbox" name="fag" value="Utenomhusarbeider"><span>Utenomhusarbeider</span></label>
            <label><input type="checkbox" name="fag" value="Grunn- og VA-arbeider"><span>Grunn- og VA-arbeider</span></label>
            <label><input type="checkbox" name="fag" value="Skjøtsel og vedlikehold"><span>Skjøtsel og vedlikehold</span></label>
            <label><input type="checkbox" name="fag" value="Rivearbeider"><span>Rivearbeider</span></label>
            <label><input type="checkbox" name="fag" value="Annet"><span>Annet</span></label>
          </div>
        </fieldset>
        <div class="form-row">
          <label for="cf-message">Melding</label>
          <textarea id="cf-message" name="message" required aria-describedby="hint-message err-message"></textarea>
          <span class="form-hint" id="hint-message">Gjelder det et prosjekt, er det fint med sted, omtrentlig størrelse og når det passer.</span>
          <span class="form-error" id="err-message" hidden>Skriv noen ord om hva det gjelder.</span>
        </div>
        <button type="submit" class="btn kontakt-send">Send melding</button>
        <p class="form-status" id="formStatus" role="status" aria-live="polite" hidden></p>
      </form>
    </div>

    <aside class="contact-aside">
      <div class="contact-lines">
        <a class="contact-line contact-line-link" href="mailto:post@oliva-park.no">
          <span class="k">E-post</span>
          <span class="v">post@oliva-park.no</span>
        </a>
        <a class="contact-line contact-line-link kontakt-adresse" href="https://www.google.com/maps/search/?api=1&query=Tr%C3%B8skenveien+36%2C+1712+Gr%C3%A5lum" target="_blank" rel="noopener">
          <span class="k">Adresse</span>
          <span class="v">Trøskenveien 36, 1712 Grålum</span>
        </a>
      </div>
      <div class="kontakt-kart" id="kart" role="img" aria-label="Kart som viser Trøskenveien 36, 1712 Grålum"></div>
    </aside>
  </div>
</section>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
  (function () {
    if (!window.L) return;
    var pos = [59.299351, 11.080185];
    var kart = L.map('kart', { scrollWheelZoom: false, zoomControl: false, attributionControl: true }).setView(pos, 13);
    L.control.zoom({ position: 'bottomright' }).addTo(kart);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(kart);
    var nal = L.divIcon({ className: 'kart-nal', html: '<span></span>', iconSize: [28, 28], iconAnchor: [14, 14] });
    L.marker(pos, { icon: nal, title: 'Oliva Park, Trøskenveien 36' }).addTo(kart);
  })();
</script>
<script>
  (function () {
    var form = document.getElementById('contactForm');
    var status = document.getElementById('formStatus');
    if (!form) return;

    var fields = [
      { input: form.name, error: document.getElementById('err-name'), valid: function (v) { return v.length > 0; } },
      { input: form.email, error: document.getElementById('err-email'), valid: function (v) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v); } },
      { input: form.message, error: document.getElementById('err-message'), valid: function (v) { return v.length > 0; } }
    ];

    function check(field, showError) {
      var ok = field.valid(field.input.value.trim());
      field.input.setAttribute('aria-invalid', ok ? 'false' : 'true');
      field.error.hidden = ok || !showError;
      field.input.classList.toggle('is-invalid', !ok && showError);
      return ok;
    }

    fields.forEach(function (field) {
      field.input.addEventListener('blur', function () { check(field, true); });
      field.input.addEventListener('input', function () {
        if (field.input.classList.contains('is-invalid')) check(field, true);
      });
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var results = fields.map(function (f) { return check(f, true); });
      var allOk = results.indexOf(false) === -1;

      if (!allOk) {
        status.hidden = false;
        status.className = 'form-status is-error';
        status.textContent = 'Fyll ut feltene som er merket, så sender vi deg videre til e-post.';
        for (var i = 0; i < fields.length; i++) {
          if (fields[i].input.classList.contains('is-invalid')) { fields[i].input.focus(); break; }
        }
        return;
      }

      var fag = Array.prototype.filter.call(form.querySelectorAll('input[name="fag"]'), function (c) { return c.checked; }).map(function (c) { return c.value; });
      var body = 'Navn: ' + form.name.value.trim() + '\nE-post: ' + form.email.value.trim() + (fag.length ? '\nGjelder: ' + fag.join(', ') : '') + '\n\n' + form.message.value.trim();
      status.hidden = false;
      status.className = 'form-status is-ok';
      status.textContent = 'Åpner e-postprogrammet ditt med meldingen klar. Får du ikke opp noe, send til post@oliva-park.no.';
      window.location.href = 'mailto:post@oliva-park.no?subject=' + encodeURIComponent('Henvendelse fra nettsiden') + '&body=' + encodeURIComponent(body);
    });
  })();
</script>
