---
layout: base.njk
---
{% from "service-hero.njk" import serviceHero, cta %}
{{ serviceHero(bilde, tittel, tittel, "", tittel, "/referanser/", "Referanser", (kategori | join(", ")) + ", " + sted) }}
<section class="h-sek">
  <div class="wrap">
    <div class="prosjekt-intro reveal">
      <p class="prosjekt-desc">{{ beskrivelse }}</p>
    </div>
    {% if bilder %}
    <div class="service-gallery reveal-group">
      <div class="service-gallery-grid">
        {% for b in bilder %}
        <button type="button" class="g-item reveal" onclick="openLightbox(this)"><img src="{{ b }}" alt="{{ tittel }}" loading="lazy"></button>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>
  <div class="wrap">
    <div class="h-head reveal" style="margin-top: clamp(72px, 9vw, 128px);"><h2>Andre prosjekter</h2><p><a class="h-lenke" href="/referanser/">Se alle prosjekter →</a></p></div>
    <div class="ref-rutenett ref-rutenett-3 reveal-group">
      {% for p in collections.prosjekter %}{% if p.data.tittel != tittel %}
      <a class="ref-flis reveal" href="{{ p.url }}">
        <img src="{{ p.data.bilde }}" alt="{{ p.data.tittel }}" loading="lazy">
        <span class="ref-flis-tekst">
          <span class="ref-flis-kat">{{ p.data.kategori | join(", ") }}</span>
          <h3>{{ p.data.tittel }}</h3>
          <span class="ref-flis-sted">{{ p.data.sted }}</span>
        </span>
      </a>
      {% endif %}{% endfor %}
    </div>
  </div>
</section>
{{ cta() }}
<div class="lightbox" id="lightbox">
  <button type="button" class="lightbox-close" onclick="closeLightbox()" aria-label="Lukk">&times;</button>
  <button type="button" class="lightbox-nav lightbox-prev" onclick="stepLightbox(-1)" aria-label="Forrige bilde">&#8249;</button>
  <img id="lightbox-img" src="" alt="">
  <button type="button" class="lightbox-nav lightbox-next" onclick="stepLightbox(1)" aria-label="Neste bilde">&#8250;</button>
</div>
<script>
  var galleryImages = Array.prototype.map.call(document.querySelectorAll('.g-item img'), function (img) {
    return { src: img.src, alt: img.alt };
  });
  var lightboxIndex = 0;

  function showLightboxImage(index) {
    if (!galleryImages.length) return;
    lightboxIndex = (index + galleryImages.length) % galleryImages.length;
    var current = galleryImages[lightboxIndex];
    document.getElementById('lightbox-img').src = current.src;
    document.getElementById('lightbox-img').alt = current.alt;
  }

  function openLightbox(btn) {
    var img = btn.querySelector('img');
    if (!img) return;
    var index = galleryImages.findIndex(function (g) { return g.src === img.src; });
    showLightboxImage(index === -1 ? 0 : index);
    document.getElementById('lightbox').classList.add('open');
  }
  function closeLightbox() { document.getElementById('lightbox').classList.remove('open'); }
  function stepLightbox(dir) { showLightboxImage(lightboxIndex + dir); }

  document.addEventListener('keydown', function (e) {
    if (!document.getElementById('lightbox').classList.contains('open')) return;
    if (e.key === 'ArrowLeft') stepLightbox(-1);
    if (e.key === 'ArrowRight') stepLightbox(1);
    if (e.key === 'Escape') closeLightbox();
  });
</script>
